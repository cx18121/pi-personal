{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "extensions/audit.ts",
    "extensions/corrections.ts",
    "extensions/cx.ts",
    "extensions/reflect.ts",
    "lib/audit.ts",
    "lib/corrections.ts",
    "lib/cx.ts"
  ]
}
