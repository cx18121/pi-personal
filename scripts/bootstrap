#!/usr/bin/env bash
set -euo pipefail

root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
profile=${1:-}
case "$profile" in
  macos|linux) ;;
  *)
    printf 'usage: %s {macos|linux}\n' "$0" >&2
    exit 2
    ;;
esac

lock_hash=$(node -e '
  const { createHash } = require("node:crypto");
  const { readFileSync } = require("node:fs");
  process.stdout.write(createHash("sha256").update(readFileSync(process.argv[1])).digest("hex"));
' "$root/package-lock.json")
stamp="$root/node_modules/.pi-personal-package-lock"
if [[ ! -f "$stamp" || "$(<"$stamp")" != "$lock_hash" ]]; then
  npm --prefix "$root" ci
  printf '%s\n' "$lock_hash" > "$stamp"
fi

node "$root/scripts/settings.mjs" "$profile"
node "$root/scripts/patch-extension-peers.mjs"
mkdir -p "$HOME/.pi/agent" "$HOME/.pi/agent/pi-codex-subagents/agents" "$HOME/.config/rpiv-ask-user-question"
ln -sfn "$root/modules/cxstack/AGENTS.md" "$HOME/.pi/agent/AGENTS.md"
ln -sfn "$root/config/compact-tools.json" "$HOME/.pi/agent/compact-tools.json"
ln -sfn "$root/config/pi-codex-subagents/config.json" "$HOME/.pi/agent/pi-codex-subagents/config.json"
ln -sfn "$root/config/pi-codex-subagents/SYSTEM.md" "$HOME/.pi/agent/pi-codex-subagents/SYSTEM.md"
ln -sfn "$root/config/pi-codex-subagents/agents/reviewer.md" "$HOME/.pi/agent/pi-codex-subagents/agents/reviewer.md"
ln -sfn "$root/config/rpiv-ask-user-question.json" "$HOME/.config/rpiv-ask-user-question/config.json"
mise -C "$root" run check -- "$profile"
