#!/usr/bin/env bash
set -euo pipefail

root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
profile=${1:-}
case "$profile" in
  macos|linux) ;;
  *)
    printf 'usage: %s {macos|linux}\n' "$0" >&2
    exit 2
    ;;
esac

if [[ $(pi --version) != "0.85.1" ]]; then
  printf 'Expected Pi 0.85.1.\n' >&2
  exit 1
fi
if [[ ! -d "$root/node_modules" ]]; then
  printf 'pi-personal dependencies are not installed.\n' >&2
  exit 1
fi

node "$root/scripts/settings.mjs" --check "$profile"
printf 'Portable Pi setup is ready for %s.\n' "$profile"
