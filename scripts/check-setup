#!/usr/bin/env bash
set -euo pipefail

root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
profile=${1:-}
case "$profile" in
  macos|linux) ;;
  *)
    printf 'usage: %s {macos|linux}\n' "$0" >&2
    exit 2
    ;;
esac

node "$root/scripts/check-pi-version.mjs" "$(pi --version)"
if [[ ! -d "$root/node_modules" ]]; then
  printf 'pi-personal dependencies are not installed.\n' >&2
  exit 1
fi

node "$root/scripts/settings.mjs" --check "$profile"
for link in "AGENTS.md:$root/modules/cxstack/AGENTS.md" "extensions/processes.json:$root/config/processes.json"; do
  if [[ "$(readlink "$HOME/.pi/agent/${link%%:*}")" != "${link#*:}" ]]; then
    printf '~/.pi/agent/%s is not linked to %s. Run bootstrap.\n' "${link%%:*}" "${link#*:}" >&2
    exit 1
  fi
done
printf 'Portable Pi setup is ready for %s.\n' "$profile"
