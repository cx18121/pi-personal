#!/usr/bin/env bash
set -euo pipefail

root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
profile=${1:-}
case "$profile" in
  macos|linux) ;;
  *)
    printf 'usage: %s {macos|linux}\n' "$0" >&2
    exit 2
    ;;
esac

node "$root/scripts/check-pi-version.mjs" "$(pi --version)"
if [[ ! -d "$root/node_modules" ]]; then
  printf 'pi-personal dependencies are not installed.\n' >&2
  exit 1
fi

node "$root/scripts/settings.mjs" --check "$profile"
for target in "$HOME/.pi/agent/AGENTS.md" "$HOME/.claude/CLAUDE.md"; do
  expected="$root/modules/cxstack/AGENTS.md"
  if [[ "$(readlink "$target" || true)" != "$expected" ]]; then
    printf '%s is not linked to %s. Run bootstrap.\n' "$target" "$expected" >&2
    exit 1
  fi
done
printf 'Portable Pi setup is ready for %s.\n' "$profile"
